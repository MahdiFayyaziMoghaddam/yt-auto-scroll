{
	"manifest_version": 3,
	"name": "YT Auto Scroll",
	"version": "1.0.0",
	"description": "Auto scroll for YouTube Shorts by @mhdifyyzi",
	"permissions": ["storage"],
	"host_permissions": ["*://*.youtube.com/*"],
	"icons": {
		"16": "icon.png",
		"32": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"action": {
		"default_popup": "index.html",
		"default_title": "YT Auto Scroll",
		"default_icon": {
			"16": "icon.png",
			"32": "icon.png",
			"48": "icon.png",
			"128": "icon.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["*://*.youtube.com/shorts/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
